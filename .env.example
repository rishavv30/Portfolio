# Django Portfolio - Environment Variables Example
# Copy this file to .env and fill in your actual values

# Django Secret Key (generate a new one for production)
SECRET_KEY=your-secure-secret-key-here

# Email Configuration (for contact form notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-gmail-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Debug Mode (set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated in production)
# On Render the .onrender.com host is added automatically from
# RENDER_EXTERNAL_HOSTNAME - only list extra/custom domains here.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Extra trusted origins for CSRF (comma-separated, scheme included).
# The Render URL is added automatically; set this only for custom domains.
# CSRF_TRUSTED_ORIGINS=https://www.yourdomain.com

# Database. Leave unset to use the local SQLite file; set to a Postgres URL
# in production to keep contact submissions across deploys.
# DATABASE_URL=postgres://user:password@host:5432/dbname
